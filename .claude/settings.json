{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-changelog.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
